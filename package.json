{
  "name": "ai-software-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "start": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test server/bridge.test.mjs server/orchestrator.test.mjs server/generation.test.mjs",
    "test:orchestrator": "node --test server/orchestrator.test.mjs",
    "test:generation": "node --test server/generation.test.mjs",
    "generation:check": "node scripts/generate-smoke.mjs --check",
    "generation:smoke": "node scripts/generate-smoke.mjs --run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
