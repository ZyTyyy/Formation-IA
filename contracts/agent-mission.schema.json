{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission de rôle v1 — contrat cible, sans exécution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "mode",
    "missionId",
    "attempt",
    "role",
    "inputRevision",
    "context",
    "workspaceId",
    "projectId",
    "runId",
    "purpose",
    "objective",
    "brief",
    "inputs",
    "dependencies",
    "permissions",
    "expectedArtifacts",
    "acceptanceCriteria",
    "limits",
    "mustDifferFromExecutionIds"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "example",
        "real"
      ]
    },
    "missionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "product_manager",
        "ux_designer",
        "software_architect",
        "fullstack_developer",
        "qa_engineer",
        "code_reviewer"
      ]
    },
    "inputRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "context": {
      "enum": [
        "factory",
        "application"
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "purpose": {
      "enum": [
        "initial",
        "correction",
        "verification"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "brief": {
      "type": "string",
      "minLength": 10,
      "maxLength": 12000
    },
    "inputs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "revision",
          "producerMissionId"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*(?![\\s\\S])"
          },
          "revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "producerMissionId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readPaths",
        "writePaths",
        "commandIds"
      ],
      "properties": {
        "readPaths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*/?(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "writePaths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*/?(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "commandIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      }
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*/?(?![\\s\\S])"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutMs",
        "maxAttempts",
        "maxOutputBytes"
      ],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mustDifferFromExecutionIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "code_reviewer"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "mustDifferFromExecutionIds": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "mustDifferFromExecutionIds": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
