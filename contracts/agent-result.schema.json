{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Résultat de rôle v1 — déclaration à vérifier côté serveur",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "mode",
    "missionId",
    "attempt",
    "role",
    "inputRevision",
    "status",
    "summary",
    "artifacts",
    "checks",
    "findings",
    "blockers",
    "nextAction"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "example",
        "real"
      ]
    },
    "missionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "product_manager",
        "ux_designer",
        "software_architect",
        "fullstack_developer",
        "qa_engineer",
        "code_reviewer"
      ]
    },
    "inputRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "ready",
        "needs_changes",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "revision"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*(?![\\s\\S])"
          },
          "revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "status",
          "evidenceId",
          "note"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidenceId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidenceId": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
                }
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "path",
          "line",
          "description",
          "reproduction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reproduction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "nextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "not_run"
                  ]
                }
              }
            }
          },
          "findings": {
            "items": {
              "properties": {
                "priority": {
                  "enum": [
                    "P2",
                    "P3"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_changes"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "enum": [
              "qa_engineer",
              "code_reviewer"
            ]
          },
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
