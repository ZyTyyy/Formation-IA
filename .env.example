# Disabled by default. Enabling the bridge allows real, metered Codex CLI jobs.
CODEX_BRIDGE_ENABLED=0
PORT=4318
# Optional absolute path if codex is not on PATH.
# CODEX_BIN=C:\\path\\to\\codex.exe

# Separate, metered OpenAI API generation. Never sent to the browser.
# Variables must be set in the server environment; this file is not auto-loaded.
FACTORY_GENERATION_ENABLED=0
# FACTORY_GENERATION_MODEL=<explicit model available to your API account>
# OPENAI_API_KEY=<set locally, never commit or paste into a chat>
